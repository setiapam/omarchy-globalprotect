#!/bin/bash
# omarchy:summary=Install GlobalProtect VPN service and sudoers helper
# omarchy:requires-sudo=true

set -euo pipefail

echo "==> Checking dependencies..."
if ! command -v gpclient >/dev/null 2>&1; then
  echo "    gpclient is not installed. Installing globalprotect-openconnect..."
  omarchy-pkg-add globalprotect-openconnect || yay -S --noconfirm globalprotect-openconnect
else
  echo "    ✓ gpclient is installed."
fi

PLUGIN_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG_DIR="$HOME/.config/globalprotect"
mkdir -p "$CONFIG_DIR"

if [[ ! -f "$CONFIG_DIR/config" ]]; then
  cp "$PLUGIN_DIR/config/globalprotect/config.example" "$CONFIG_DIR/config"
  echo "    Created default config at $CONFIG_DIR/config"
fi

echo "==> Installing validated helper script to /usr/local/lib/omarchy/globalprotect-helper..."
HELPER_DIR="/usr/local/lib/omarchy"
HELPER_PATH="$HELPER_DIR/globalprotect-helper"
sudo mkdir -p "$HELPER_DIR"
sudo cp "$PLUGIN_DIR/lib/omarchy-globalprotect-helper" "$HELPER_PATH"
sudo chown root:root "$HELPER_PATH"
sudo chmod 0755 "$HELPER_PATH"

echo "==> Configuring sudoers rule..."
SUDOERS_FILE="/etc/sudoers.d/omarchy-globalprotect"
{
  echo "%wheel ALL=(ALL) NOPASSWD: $HELPER_PATH"
  echo "%sudo  ALL=(ALL) NOPASSWD: $HELPER_PATH"
} | sudo tee "$SUDOERS_FILE" >/dev/null
sudo chmod 0440 "$SUDOERS_FILE"

if ! sudo visudo -c -f "$SUDOERS_FILE" >/dev/null 2>&1; then
  echo "ERROR: sudoers syntax check failed — removing file"
  sudo rm -f "$SUDOERS_FILE"
  exit 1
fi

echo "==> Linking CLI commands to ~/.local/bin..."
LINK_DIR="$HOME/.local/bin"
mkdir -p "$LINK_DIR"
for cmd in omarchy-globalprotect omarchy-globalprotect-up omarchy-globalprotect-down omarchy-globalprotect-status omarchy-globalprotect-config; do
  ln -sf "$PLUGIN_DIR/bin/$cmd" "$LINK_DIR/$cmd"
done

echo "==> Enabling plugin in Omarchy..."
omarchy plugin enable setiapam.globalprotect 2>/dev/null || true

echo "✓ GlobalProtect VPN plugin installed successfully!"
