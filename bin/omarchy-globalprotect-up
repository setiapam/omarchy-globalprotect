#!/bin/bash
# omarchy:summary=Connect to GlobalProtect VPN
# omarchy:args=[config_name]

set -euo pipefail

CONFIG_NAME="${1:-config}"
CONFIG_DIR="$HOME/.config/globalprotect"
CONFIG_FILE="$CONFIG_DIR/$CONFIG_NAME"
RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-globalprotect"
mkdir -p "$RUN_DIR"
chmod 700 "$RUN_DIR"
PID_FILE="$RUN_DIR/${CONFIG_NAME}.pid"
LOCK_FILE="$RUN_DIR/${CONFIG_NAME}.lock"
ERROR_FILE="$RUN_DIR/${CONFIG_NAME}.error"
AUTH_LOG="$RUN_DIR/${CONFIG_NAME}-auth.log"
GP_LOG="$RUN_DIR/${CONFIG_NAME}-gpclient.log"
BROWSER_WRAPPER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/omarchy-globalprotect-browser-wrapper"

rm -f "$ERROR_FILE"

notify_error() {
  local message="$1"
  printf '%s\n' "$message" > "$ERROR_FILE"
  echo "✗ $message" >&2
  omarchy-notification-send "GlobalProtect" "$message" 2>/dev/null || true
}

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "Another instance of globalprotect-up is already running."
  exit 0
fi

if ! command -v gpclient >/dev/null 2>&1; then
  notify_error "Error: gpclient is not installed. Install globalprotect-openconnect."
  exit 1
fi

existing_pid=$(cat "$PID_FILE" 2>/dev/null || true)
if [[ -n "$existing_pid" ]] \
  && kill -0 "$existing_pid" 2>/dev/null \
  && grep -qa "gpclient" "/proc/$existing_pid/cmdline" 2>/dev/null; then
  echo "VPN is already connected (PID: $existing_pid)"
  exit 0
else
  rm -f "$PID_FILE"
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
  notify_error "Error: Config file not found: $CONFIG_FILE"
  exit 1
fi

get_cfg() {
  local k="$1"
  local line
  line=$(grep -i "^[[:space:]]*${k}[[:space:]]*=" "$CONFIG_FILE" 2>/dev/null | head -1 || true)
  if [[ -n "$line" ]]; then
    echo "$line" | sed 's/^[^=]*=[[:space:]]*//' | sed 's/[[:space:]]*$//'
  else
    echo ""
  fi
}

PORTAL=$(get_cfg "portal")
if [[ -z "$PORTAL" ]]; then
  notify_error "Error: portal is not configured in $CONFIG_FILE"
  exit 1
fi
PORTAL="${PORTAL#https://}"
PORTAL="${PORTAL#http://}"
PORTAL="${PORTAL%/}"

GATEWAY=$(get_cfg "gateway")
USERNAME=$(get_cfg "username")
PASSWORD=$(get_cfg "password")
SAML=$(get_cfg "saml")
TOTP=$(get_cfg "totp")
HEADLESS=$(get_cfg "headless")
BROWSER=$(get_cfg "browser")
IGNORE_TLS=$(get_cfg "ignore-tls-errors")
FIX_OPENSSL=$(get_cfg "fix-openssl")
NO_DTLS=$(get_cfg "no-dtls")

# Defaults for configs written by older plugin versions. Normalize booleans so
# hand-edited configs using True/Yes also work.
SAML=$(printf '%s' "${SAML:-true}" | tr '[:upper:]' '[:lower:]')
HEADLESS=$(printf '%s' "${HEADLESS:-true}" | tr '[:upper:]' '[:lower:]')
IGNORE_TLS=$(printf '%s' "${IGNORE_TLS:-false}" | tr '[:upper:]' '[:lower:]')
FIX_OPENSSL=$(printf '%s' "${FIX_OPENSSL:-false}" | tr '[:upper:]' '[:lower:]')
NO_DTLS=$(printf '%s' "${NO_DTLS:-false}" | tr '[:upper:]' '[:lower:]')
BROWSER="${BROWSER:-default}"

GLOBAL_ARGS=()
CONNECT_ARGS=("connect" "$PORTAL")

[[ "$IGNORE_TLS" == "true" ]] && GLOBAL_ARGS+=("--ignore-tls-errors")
[[ "$FIX_OPENSSL" == "true" ]] && GLOBAL_ARGS+=("--fix-openssl")
if [[ -n "$GATEWAY" ]]; then
  CONNECT_ARGS+=("--gateway" "$GATEWAY")
else
  # With multiple external gateways gpclient otherwise prompts on a TTY.
  CONNECT_ARGS+=("--auto-gateway")
fi
# BPS gateways ask for a HIP report; without it internal hosts are blocked.
CONNECT_ARGS+=("--hip")
[[ "$NO_DTLS" == "true" ]] && CONNECT_ARGS+=("--no-dtls")
[[ -n "$USERNAME" ]] && CONNECT_ARGS+=("--user" "$USERNAME")

export TMPDIR=/tmp

# pkexec sanitizes the environment. Preserve the session variables that the
# browser fallback and gpclient's desktop helpers need.
ENV_ARGS=("TMPDIR=/tmp")
[[ -n "${DISPLAY:-}" ]] && ENV_ARGS+=("DISPLAY=$DISPLAY")
[[ -n "${WAYLAND_DISPLAY:-}" ]] && ENV_ARGS+=("WAYLAND_DISPLAY=$WAYLAND_DISPLAY")
[[ -n "${XDG_RUNTIME_DIR:-}" ]] && ENV_ARGS+=("XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR")
[[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] && ENV_ARGS+=("DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS")
[[ -n "${XAUTHORITY:-}" ]] && ENV_ARGS+=("XAUTHORITY=$XAUTHORITY")

# Detach the privileged client into its own session so it survives the short-
# lived Omarchy panel process that invokes this script.
if command -v setsid >/dev/null 2>&1; then
  SETSID_PREFIX=(setsid -w)
else
  SETSID_PREFIX=()
fi

echo "==> Connecting to GlobalProtect VPN ($CONFIG_NAME)..."

# Headless SAML + TOTP: obtain the prelogin/portal cookies ourselves and feed
# them to gpclient. No browser window is opened.
if [[ "$SAML" == "true" && "$HEADLESS" == "true" && -n "$TOTP" ]]; then
  AUTH_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/omarchy-globalprotect-auth"
  if [[ ! -x "$AUTH_BIN" ]]; then
    notify_error "Error: authentication helper is not executable: $AUTH_BIN"
    exit 1
  fi
  if [[ ! -x "$BROWSER_WRAPPER" ]]; then
    notify_error "Error: hidden-browser wrapper is not executable: $BROWSER_WRAPPER"
    exit 1
  fi

  echo "==> Performing headless SAML login with TOTP..."
  : > "$AUTH_LOG"
  if ! AUTH_JSON=$("$AUTH_BIN" --config "$CONFIG_FILE" 2>>"$AUTH_LOG"); then
    tail -n 5 "$AUTH_LOG" >&2 || true
    detail=$(tail -n 1 "$AUTH_LOG" 2>/dev/null || true)
    notify_error "SAML login failed.${detail:+ $detail}"
    exit 1
  fi

  if [[ -z "$AUTH_JSON" ]]; then
    notify_error "SAML login failed: authentication helper returned no data."
    exit 1
  fi

  : > "$GP_LOG"
  printf '%s\n' "$AUTH_JSON" | "${SETSID_PREFIX[@]}" pkexec env "${ENV_ARGS[@]}" gpclient "${GLOBAL_ARGS[@]}" "${CONNECT_ARGS[@]}" --cookie-on-stdin --browser "$BROWSER_WRAPPER" >"$GP_LOG" 2>&1 &
  VPN_PID=$!
  echo "$VPN_PID" > "$PID_FILE"

  sleep 3
  if kill -0 "$VPN_PID" 2>/dev/null; then
    echo "✓ GlobalProtect connection launched (PID: $VPN_PID)"
    omarchy-notification-send "GlobalProtect" "Connected via SAML/TOTP" 2>/dev/null || true
    wait "$VPN_PID" || true
    rm -f "$PID_FILE"
    exit 0
  fi

  rm -f "$PID_FILE"
  detail=$(tail -n 1 "$AUTH_LOG" 2>/dev/null || true)
  [[ -n "$detail" ]] || detail=$(tail -n 1 "$GP_LOG" 2>/dev/null || true)
  notify_error "GlobalProtect connection ended during startup.${detail:+ $detail}"
  exit 1
fi

# SAML without a TOTP secret: fall back to the interactive browser flow.
if [[ "$SAML" == "true" ]]; then
  if [[ -z "$TOTP" ]]; then
    echo "TOTP secret is empty; falling back to browser-based SAML login."
    omarchy-notification-send "GlobalProtect" "TOTP not configured; opening browser login" 2>/dev/null || true
  fi
  [[ -n "$BROWSER" ]] && CONNECT_ARGS+=("--browser" "$BROWSER")
  : > "$GP_LOG"
  "${SETSID_PREFIX[@]}" pkexec env "${ENV_ARGS[@]}" gpclient "${GLOBAL_ARGS[@]}" "${CONNECT_ARGS[@]}" >"$GP_LOG" 2>&1 &
  VPN_PID=$!
  echo "$VPN_PID" > "$PID_FILE"

  sleep 3
  if kill -0 "$VPN_PID" 2>/dev/null; then
    echo "✓ GlobalProtect connection launched (PID: $VPN_PID)"
    omarchy-notification-send "GlobalProtect" "Connection process started..." 2>/dev/null || true
    wait "$VPN_PID" || true
    rm -f "$PID_FILE"
    exit 0
  fi

  rm -f "$PID_FILE"
  notify_error "GlobalProtect connection ended or was cancelled."
  exit 1
fi

# Username/password (non-SAML) authentication.
if [[ -z "$PASSWORD" ]]; then
  notify_error "Error: password is empty for non-SAML authentication."
  exit 1
fi

CONNECT_ARGS+=("--passwd-on-stdin")
: > "$GP_LOG"
printf '%s\n' "$PASSWORD" | "${SETSID_PREFIX[@]}" pkexec env "${ENV_ARGS[@]}" gpclient "${GLOBAL_ARGS[@]}" "${CONNECT_ARGS[@]}" >"$GP_LOG" 2>&1 &
VPN_PID=$!
echo "$VPN_PID" > "$PID_FILE"

sleep 3
if kill -0 "$VPN_PID" 2>/dev/null; then
  echo "✓ GlobalProtect connection launched (PID: $VPN_PID)"
  omarchy-notification-send "GlobalProtect" "Connection process started..." 2>/dev/null || true
  exit 0
fi

rm -f "$PID_FILE"
notify_error "GlobalProtect connection ended or was cancelled."
exit 1
