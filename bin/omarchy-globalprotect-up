#!/bin/bash
# omarchy:summary=Connect to GlobalProtect VPN
# omarchy:args=[config_name]

set -euo pipefail

CONFIG_NAME="${1:-config}"
CONFIG_DIR="$HOME/.config/globalprotect"
CONFIG_FILE="$CONFIG_DIR/$CONFIG_NAME"

PORTAL="vpn.bps.go.id"
USERNAME="setia.pambudi"
BROWSER="default"

if [[ -f "$CONFIG_FILE" ]]; then
  p=$(grep -E "^[[:space:]]*portal[[:space:]]*=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d ' ' || true)
  [[ -n "$p" ]] && PORTAL="$p"
  u=$(grep -E "^[[:space:]]*username[[:space:]]*=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d ' ' || true)
  [[ -n "$u" ]] && USERNAME="$u"
  b=$(grep -E "^[[:space:]]*browser[[:space:]]*=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d ' ' || true)
  [[ -n "$b" ]] && BROWSER="$b"
fi

# Serialize connect attempts and start the required system daemon first.
RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-globalprotect"
mkdir -p "$RUN_DIR"
chmod 700 "$RUN_DIR"
exec 9>"$RUN_DIR/connect.lock"
flock -n 9 || exit 0

if ! systemctl is-active --quiet gpd.service; then
  echo "Starting GlobalProtect daemon (administrator authentication may be required)..."
  pkexec /usr/bin/systemctl start gpd.service
fi
systemctl is-active --quiet gpd.service || { echo "GlobalProtect daemon failed to start." >&2; exit 1; }

# Clean up any stale cli connect instances
pkill -x globalprotect 2>/dev/null || true

# Ensure PanGPA is running in user session
if ! pgrep -u "$USER" PanGPA >/dev/null 2>&1; then
  /opt/paloaltonetworks/globalprotect/PanGPA start 9>&- &
  sleep 1
fi

# Set custom browser if configured
if [[ -n "$BROWSER" && "$BROWSER" != "default" ]]; then
  export BROWSER="$BROWSER"
fi

echo "Connecting to GlobalProtect ($PORTAL) for user $USERNAME..."
globalprotect connect -p "$PORTAL" -u "$USERNAME" 9>&- &

# Background monitor to send desktop notification once connected
(
  for i in {1..60}; do
    sleep 1
    st=$("$(dirname "${BASH_SOURCE[0]}")/omarchy-globalprotect-status" 2>/dev/null || true)
    if [[ "$st" == *'"status":"connected"'* ]]; then
      omarchy-notification-send "GlobalProtect" "Connected to $PORTAL" 2>/dev/null || notify-send "GlobalProtect" "Connected to $PORTAL" 2>/dev/null || true
      break
    fi
  done
) >/dev/null 2>&1 &
