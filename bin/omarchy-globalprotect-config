#!/bin/bash
# omarchy:summary=Read or write GlobalProtect configuration
# omarchy:args=[action] [args...]

set -euo pipefail

CONFIG_DIR="$HOME/.config/globalprotect"
CONFIG_FILE="$CONFIG_DIR/config"
mkdir -p "$CONFIG_DIR"

action="${1:-read-all}"

case "$action" in
  read-all)
    portal="vpn.bps.go.id"
    username="setia.pambudi"
    browser="brave"

    if [[ -f "$CONFIG_FILE" ]]; then
      p=$(grep -E "^[[:space:]]*portal[[:space:]]*=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d ' ' || true)
      [[ -n "$p" ]] && portal="$p"
      u=$(grep -E "^[[:space:]]*username[[:space:]]*=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d ' ' || true)
      [[ -n "$u" ]] && username="$u"
      b=$(grep -E "^[[:space:]]*browser[[:space:]]*=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d ' ' || true)
      [[ -n "$b" ]] && browser="$b"
    fi

    echo "{\"portal\":\"$portal\",\"username\":\"$username\",\"browser\":\"$browser\"}"
    ;;

  write)
    portal="${2:-vpn.bps.go.id}"
    username="${3:-setia.pambudi}"
    browser="${4:-brave}"

    cat << CFGEOF > "$CONFIG_FILE"
# GlobalProtect VPN Configuration for BPS
portal = $portal
username = $username
browser = $browser
CFGEOF
    echo "{\"status\":\"ok\"}"
    ;;

  *)
    echo "Usage: $0 [read-all|write <portal> <username> <browser>]"
    exit 1
    ;;
esac
