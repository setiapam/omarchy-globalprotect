#!/bin/bash
# omarchy:summary=Check GlobalProtect connection status
# omarchy:args=[config_name]

set -euo pipefail

CONFIG_NAME="${1:-config}"
CONFIG_FILE="$HOME/.config/globalprotect/$CONFIG_NAME"

status="disconnected"
pid=""
portal="vpn.bps.go.id"
uptime_secs="null"
pkg_installed="false"

if command -v globalprotect >/dev/null 2>&1; then
  pkg_installed="true"
fi

if [[ -f "$CONFIG_FILE" ]]; then
  cfg_p=$(grep -E "^[[:space:]]*portal[[:space:]]*=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d ' ' || true)
  [[ -n "$cfg_p" ]] && portal="$cfg_p"
fi

# TUN devices may report operstate UNKNOWN while fully connected.
# An active gpd0 with an assigned IPv4 address is the fast polling path.
tunnel_active=false
if [[ -r /sys/class/net/gpd0/flags ]]; then
  tunnel_flags=$(cat /sys/class/net/gpd0/flags)
  if (( tunnel_flags & 1 )) && ip -o -4 address show dev gpd0 | grep -q ' inet ' && pgrep -x PanGPS >/dev/null; then
    tunnel_active=true
  fi
fi

if [[ "$tunnel_active" == "true" ]]; then
  status="connected"
else
  # Preserve any useful output even if the CLI exits on timeout.
  cli_output=$(timeout 5 globalprotect show --status 2>/dev/null || true)
  gp_status=$(printf '%s' "$cli_output" | tr '\r' '\n' | grep -i "GlobalProtect status:" | tr '[:upper:]' '[:lower:]' || true)
  if [[ "$gp_status" =~ "connected" ]] && ! [[ "$gp_status" =~ (disconnected|disabled) ]]; then
    status="connected"
  elif [[ "$gp_status" =~ (connecting|discovering|retrieving) ]]; then
    status="connecting"
  fi
fi

if [[ "$status" == "connected" ]]; then
  pid=$(pgrep -x PanGPS | head -1 || echo "")
  if [[ -n "$pid" && -d "/proc/$pid" ]]; then
    start_time=$(stat -c %Y "/proc/$pid" 2>/dev/null || echo "")
    if [[ -n "$start_time" ]]; then
      now=$(date +%s)
      uptime_secs=$(( now - start_time ))
    fi
  fi
fi

# Print single-line JSON to prevent SplitParser line-buffering JSON.parse issues
echo "{\"status\":\"$status\",\"pid\":\"$pid\",\"portal\":\"$portal\",\"config\":\"$CONFIG_NAME\",\"pkgInstalled\":$pkg_installed,\"uptimeSeconds\":$uptime_secs}"
