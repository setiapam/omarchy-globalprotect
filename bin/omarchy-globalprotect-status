#!/bin/bash
# omarchy:summary=Check GlobalProtect connection status
# omarchy:args=[config_name]

set -euo pipefail

CONFIG_NAME="${1:-config}"
CONFIG_FILE="$HOME/.config/globalprotect/$CONFIG_NAME"

status="disconnected"
pid=""
portal="vpn.bps.go.id"
uptime_secs="null"
pkg_installed="false"

if command -v globalprotect >/dev/null 2>&1; then
  pkg_installed="true"
fi

if [[ -f "$CONFIG_FILE" ]]; then
  cfg_p=$(grep -i "^portal=" "$CONFIG_FILE" 2>/dev/null | cut -d= -f2- | tr -d ' ' || true)
  [[ -n "$cfg_p" ]] && portal="$cfg_p"
fi

# Check if gpd0 or tun interface is up
if ip link show gpd0 >/dev/null 2>&1 && [[ "$(cat /sys/class/net/gpd0/operstate 2>/dev/null)" == "up" ]]; then
  status="connected"
elif ip link show gpd0 >/dev/null 2>&1; then
  status="connected"
fi

if [[ "$status" == "connected" ]]; then
  pid=$(pgrep -x PanGPS | head -1 || echo "")
  if [[ -n "$pid" && -d "/proc/$pid" ]]; then
    start_time=$(stat -c %Y "/proc/$pid" 2>/dev/null || echo "")
    if [[ -n "$start_time" ]]; then
      now=$(date +%s)
      uptime_secs=$(( now - start_time ))
    fi
  fi
fi

# Print single-line JSON to prevent SplitParser line-buffering JSON.parse issues
echo "{\"status\":\"$status\",\"pid\":\"$pid\",\"portal\":\"$portal\",\"config\":\"$CONFIG_NAME\",\"pkgInstalled\":$pkg_installed,\"uptimeSeconds\":$uptime_secs}"
