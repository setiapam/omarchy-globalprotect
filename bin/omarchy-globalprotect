#!/bin/bash
# omarchy:summary=GlobalProtect VPN CLI frontend
# omarchy:args=[connect|disconnect|status|auth|config|install-deps]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMAND="${1:-status}"
shift || true

case "$COMMAND" in
  connect|up)
    "$SCRIPT_DIR/omarchy-globalprotect-up" "$@"
    ;;
  disconnect|down)
    "$SCRIPT_DIR/omarchy-globalprotect-down" "$@"
    ;;
  status)
    "$SCRIPT_DIR/omarchy-globalprotect-status" "$@"
    ;;
  auth|login)
    "$SCRIPT_DIR/omarchy-globalprotect-auth" "$@"
    ;;
  config)
    "$SCRIPT_DIR/omarchy-globalprotect-config" "$@"
    ;;
  install-deps)
    missing=0
    if ! command -v gpclient >/dev/null 2>&1; then
      echo "Installing globalprotect-openconnect via omarchy-pkg-add..."
      omarchy-pkg-add globalprotect-openconnect
      missing=1
    else
      echo "✓ globalprotect-openconnect already installed."
    fi
    if ! python3 -c "import requests" >/dev/null 2>&1; then
      echo "Installing python-requests via omarchy-pkg-add..."
      omarchy-pkg-add python-requests
      missing=1
    else
      echo "✓ python-requests already installed."
    fi
    if [[ "$missing" -eq 0 ]]; then
      echo "✓ All dependencies are installed."
    fi
    ;;
  help|-h|--help)
    cat <<EOF
Usage: omarchy-globalprotect <command> [options]

Commands:
  connect, up           Connect to the configured GlobalProtect portal
  disconnect, down      Disconnect active GlobalProtect VPN session
  status                Show connection status (JSON format)
  auth, login           Run headless SAML + TOTP login and print the auth JSON
  config                Read or write configuration
  install-deps          Install globalprotect-openconnect and python-requests

Headless auth examples:
  omarchy-globalprotect auth
  omarchy-globalprotect auth --dump-dir /tmp/gp-auth
  omarchy-globalprotect auth --totp GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ

The auth command prints one line of JSON suitable for:
  gpclient connect <portal> --cookie-on-stdin
EOF
    ;;
  *)
    echo "Unknown command: $COMMAND"
    echo "Run 'omarchy-globalprotect help' for usage."
    exit 1
    ;;
esac
