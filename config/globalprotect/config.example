# GlobalProtect VPN Configuration
# Managed by omarchy-globalprotect
#
# This file is created with mode 600 because it can contain a password and a
# TOTP secret. Keep it private.

# VPN Portal Server
portal = vpn.bps.go.id

# Optional Gateway (if different from portal, or leave empty).
# Leave empty to auto-select in priority order with gpclient 2.6+.
# On gpclient 2.5.x, set this explicitly when the portal offers several
# gateways; 2.5.x has no --auto-gateway and would prompt on a TTY instead.
gateway =

# Username. For BPS, use the bare username without @bps.go.id.
username = setia.pambudi

# Password is required for both password login and headless SAML + TOTP.
password =

# SAML/SSO Authentication (true / false)
saml = true

# TOTP secret for automatic (headless) SAML login.
# Accepts:
#   - a Base32 secret, e.g. JBSWY3DPEHPK3PXP
#   - an otpauth:// URI with secret/digits/period/algorithm parameters
#   - a literal 6/8 digit code for a one-shot manual login
#
# Leave empty to fall back to the interactive browser login.
totp =

# When true and `totp` is set, no browser window is opened.
headless = true

# Browser used only by the SAML fallback: default, remote, firefox, chromium...
browser = default

# Extra flags
# Ignore TLS certificate errors
ignore-tls-errors = false

# Extended OpenSSL compatibility mode (deprecated in gpclient, kept for
# compatibility with older versions)
fix-openssl = false

# Disable DTLS/ESP tunnel
no-dtls = false
