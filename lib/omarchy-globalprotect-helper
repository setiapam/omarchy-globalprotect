#!/bin/bash
# omarchy-globalprotect-helper — root-owned, sudoers-whitelisted helper
#
# This script is the ONLY binary listed in the sudoers NOPASSWD rule.
# It validates all inputs before invoking gpclient as root.
#
# Usage (via sudo):
#   sudo /usr/local/lib/omarchy/globalprotect-helper connect <user> <config_name> [extra options...]
#   sudo /usr/local/lib/omarchy/globalprotect-helper disconnect
#   sudo /usr/local/lib/omarchy/globalprotect-helper status
#
# Installed to: /usr/local/lib/omarchy/globalprotect-helper
# Owner:        root:root, mode 0755

set -euo pipefail

readonly GPCLIENT="/usr/bin/gpclient"
readonly CONFIG_BASE_DIR="/home"
readonly CONFIG_SUBPATH=".config/globalprotect"
readonly CONFIG_NAME_RE='^[a-zA-Z0-9][a-zA-Z0-9._-]*$'
readonly MAX_CONFIG_NAME_LEN=64
readonly ALLOWED_ACTIONS="connect|disconnect|status"

die() { echo "ERROR: $*" >&2; exit 1; }

# ── validate action ──────────────────────────────────────────────────
ACTION="${1:-}"
[[ -n "$ACTION" ]] || die "missing action argument"
[[ "$ACTION" =~ ^(connect|disconnect|status)$ ]] || die "invalid action '$ACTION' (allowed: $ALLOWED_ACTIONS)"

# ── disconnect: terminate gpclient / openconnect ─────────────────────
if [[ "$ACTION" == "disconnect" ]]; then
  if [[ -x "$GPCLIENT" ]]; then
    "$GPCLIENT" disconnect --wait 5 2>/dev/null || true
  fi
  /usr/bin/pkill -x gpclient 2>/dev/null || true
  /usr/bin/pkill -f "openconnect.*globalprotect" 2>/dev/null || true
  exit 0
fi

# ── status: check if interface tun/gp exists or gpclient running ────
if [[ "$ACTION" == "status" ]]; then
  if ip link show | grep -E 'gpd[0-9]|tun[0-9]' >/dev/null 2>&1 || pgrep -x gpclient >/dev/null 2>&1; then
    echo "connected"
  else
    echo "disconnected"
  fi
  exit 0
fi

# ── connect: validate user and config name ───────────────────────────
CALLING_USER="${2:-}"
CONFIG_NAME="${3:-config}"
shift 3 || true

# Validate calling user
[[ -n "$CALLING_USER" ]] || die "missing user argument"
[[ "$CALLING_USER" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "invalid username '$CALLING_USER'"
[[ "$CALLING_USER" != "root" ]] || die "refusing to run for root"
id "$CALLING_USER" >/dev/null 2>&1 || die "user '$CALLING_USER' does not exist"

# Validate config name
[[ ${#CONFIG_NAME} -le $MAX_CONFIG_NAME_LEN ]] || die "config name too long (max $MAX_CONFIG_NAME_LEN chars)"
[[ "$CONFIG_NAME" =~ $CONFIG_NAME_RE ]] || die "invalid config name '$CONFIG_NAME' (must match $CONFIG_NAME_RE)"
[[ "$CONFIG_NAME" != *"/"* ]] || die "config name must not contain '/'"
[[ "$CONFIG_NAME" != *".."* ]] || die "config name must not contain '..'"

CONFIG_FILE="$CONFIG_BASE_DIR/$CALLING_USER/$CONFIG_SUBPATH/$CONFIG_NAME"
CANONICAL_DIR=$(readlink -f "$CONFIG_BASE_DIR/$CALLING_USER/$CONFIG_SUBPATH" 2>/dev/null) || die "cannot resolve config directory"
CANONICAL_FILE=$(readlink -f "$CONFIG_FILE" 2>/dev/null) || die "config file not found: $CONFIG_FILE"

case "$CANONICAL_FILE" in
  "$CANONICAL_DIR"/*) ;;
  *) die "config file resolves outside allowed directory" ;;
esac

[[ -f "$CONFIG_FILE" ]] || die "config file not found: $CONFIG_FILE"
[[ -r "$CONFIG_FILE" ]] || die "config file not readable: $CONFIG_FILE"

[[ -x "$GPCLIENT" ]] || die "gpclient not found at $GPCLIENT"

# Parse config values safely
get_cfg() {
  local k="$1"
  local line
  line=$(grep -i "^[[:space:]]*${k}[[:space:]]*=" "$CONFIG_FILE" 2>/dev/null | head -1 || true)
  if [[ -n "$line" ]]; then
    echo "$line" | sed 's/^[^=]*=[[:space:]]*//' | sed 's/[[:space:]]*$//'
  else
    echo ""
  fi
}

PORTAL=$(get_cfg "portal")
[[ -n "$PORTAL" ]] || die "portal is empty in $CONFIG_FILE"

GATEWAY=$(get_cfg "gateway")
USERNAME=$(get_cfg "username")
PASSWORD=$(get_cfg "password")
SAML=$(get_cfg "saml")
BROWSER=$(get_cfg "browser")
IGNORE_TLS=$(get_cfg "ignore-tls-errors")
FIX_OPENSSL=$(get_cfg "fix-openssl")
NO_DTLS=$(get_cfg "no-dtls")

ARGS=("connect" "$PORTAL")

if [[ -n "$GATEWAY" ]]; then
  ARGS+=("-g" "$GATEWAY")
fi

if [[ -n "$USERNAME" ]]; then
  ARGS+=("-u" "$USERNAME")
fi

if [[ "$IGNORE_TLS" == "true" ]]; then
  ARGS+=("--ignore-tls-errors")
fi

if [[ "$FIX_OPENSSL" == "true" ]]; then
  ARGS+=("--fix-openssl")
fi

if [[ "$NO_DTLS" == "true" ]]; then
  ARGS+=("--no-dtls")
fi

if [[ -n "$BROWSER" ]]; then
  ARGS+=("--browser" "$BROWSER")
fi

# Execute gpclient
if [[ "$SAML" != "true" && -n "$PASSWORD" ]]; then
  ARGS+=("--passwd-on-stdin")
  printf '%s\n' "$PASSWORD" | exec "$GPCLIENT" "${ARGS[@]}" "$@"
else
  exec "$GPCLIENT" "${ARGS[@]}" "$@"
fi
